;configured at runtime:
(= (IRC_channel) (empty))
(= (IRC_server) (empty))
(= (IRC_port) (empty))
(= (IRC_user) (empty))
(= (commchannel) (empty))
(= (MM_URL) (empty))
(= (MM_CHANNEL_ID) (empty))
(= (MM_BOT_TOKEN) (empty))
(= (TG_BOT_TOKEN) (empty))
(= (TG_CHAT_ID) (empty))
(= (TG_POLL_TIMEOUT) (empty))
(= (SL_BOT_TOKEN) (empty))
(= (SL_CHANNEL_ID) (empty))
(= (SL_POLL_INTERVAL) (empty))
(= (WS_URL) (empty))
(= (WS_TOKEN) (empty))

;Connect the configured channel:
(= (initChannels)
   (progn (println! "Initializing channels")
          (configure commchannel irc)
          (if (== (commchannel) irc)
              (progn (configure IRC_channel ##omegaclaw)
                     (configure IRC_server "irc.quakenet.org")
                     (configure IRC_port 6667)
                     (configure IRC_user omegaclaw)
                     (py-call (lib_channels_ext.setConfig IRC_channel (IRC_channel)))
                     (py-call (lib_channels_ext.setConfig IRC_server (IRC_server)))
                     (py-call (lib_channels_ext.setConfig IRC_port (IRC_port)))
                     (py-call (lib_channels_ext.setConfig IRC_user (IRC_user))))
              (if (== (commchannel) telegram)
                  (progn (configure TG_BOT_TOKEN "")
                         (configure TG_CHAT_ID "")
                         (configure TG_POLL_TIMEOUT 20)
                         (py-call (lib_channels_ext.setConfig TG_BOT_TOKEN (TG_BOT_TOKEN)))
                         (py-call (lib_channels_ext.setConfig TG_CHAT_ID (TG_CHAT_ID)))
                         (py-call (lib_channels_ext.setConfig TG_POLL_TIMEOUT (TG_POLL_TIMEOUT))))
                  (if (== (commchannel) slack)
                      (progn (configure SL_BOT_TOKEN "")
                             (configure SL_CHANNEL_ID "")
                             (configure SL_POLL_INTERVAL 60)
                             (py-call (lib_channels_ext.setConfig SL_BOT_TOKEN (SL_BOT_TOKEN)))
                             (py-call (lib_channels_ext.setConfig SL_CHANNEL_ID (SL_CHANNEL_ID)))
                             (py-call (lib_channels_ext.setConfig SL_POLL_INTERVAL (SL_POLL_INTERVAL))))
                      (if (== (commchannel) mattermost)
                          (progn (configure MM_URL "https://chat.singularitynet.io")
                                 (configure MM_CHANNEL_ID "8fjrmabjx7gupy7e5kjznpt5qh")
                                 (configure MM_BOT_TOKEN "")
                                 (py-call (lib_channels_ext.setConfig MM_URL (MM_URL)))
                                 (py-call (lib_channels_ext.setConfig MM_CHANNEL_ID (MM_CHANNEL_ID)))
                                 (py-call (lib_channels_ext.setConfig MM_BOT_TOKEN (MM_BOT_TOKEN))))
                          (if (== (commchannel) websocket)
                              (progn (configure WS_URL "")
                                     (configure WS_TOKEN "")
                                     (py-call (lib_channels_ext.setConfig WS_URL (WS_URL)))
                                     (py-call (lib_channels_ext.setConfig WS_TOKEN (WS_TOKEN))))
                              _)))))
          (py-call (lib_channels_ext.startChannel (commchannel)))))

;Receive the latest user message from the configured channel:
(= (receive)
   (py-call (lib_channels_ext.receive (commchannel))))

;Send a message to the configured channel:
!(change-state! &lastsend "")
(= (send $msg)
   (if (!= $msg (get-state &lastsend))
       (progn (change-state! &lastsend $msg)
              (let $safemsg (string-replace $msg  "\n" "\\n")
                   (let $temp (cut) (py-call (lib_channels_ext.send (commchannel) $safemsg))))) _))

;Search the internet for some information:
(= (search $msg)
   (py-call (websearch.search $msg)))
